# Bayit with Docker: copy to .env and fill in. Never commit .env.

# The address people open, exactly (https in production). Google sign-in and Telegram need a public https address.
BAYIT_ORIGIN=http://localhost:8080
# Only with the Caddy HTTPS profile: your domain, pointing at this machine (e.g. bayit.example.com).
BAYIT_DOMAIN=

# Google sign-in (Google Auth Platform → Clients → Web application).
# Authorized redirect URI: <BAYIT_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. If empty, Bayit generates these once and keeps them in the data volume (secrets.json).
# Keep APP_ENCRYPTION_KEY stable: stored AI keys, bot tokens and RiseUp tokens are encrypted with it.
AUTH_SECRET=
APP_ENCRYPTION_KEY=
REMINDER_CRON_SECRET=

# Optional: the host port (default 8080).
BAYIT_PORT=8080
