# Bayit with Docker: copy to .env and fill in. Never commit .env.

# The address people open, exactly. http://localhost:8080 works for real use, but only in a browser on this computer.
# Phones (passkeys), Google sign-in and Telegram need a public https address.
BAYIT_ORIGIN=http://localhost:8080
# Only with the Caddy HTTPS profile: your domain, pointing at this machine (e.g. bayit.example.com).
BAYIT_DOMAIN=

# Optional: Google sign-in. Passkeys need none of this. (Google Auth Platform → Clients → Web application.)
# Authorized redirect URI: <BAYIT_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Calendar OAuth client. Set its redirect URI to BAYIT_ORIGIN/api/google-calendar/callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional. If empty, Bayit generates these once and keeps them in the data volume (secrets.json).
# Keep APP_ENCRYPTION_KEY stable: stored AI keys, bot tokens and RiseUp tokens are encrypted with it.
AUTH_SECRET=
APP_ENCRYPTION_KEY=
REMINDER_CRON_SECRET=

# Optional: the host port (default 8080). If you change it, change the port in BAYIT_ORIGIN above too.
BAYIT_PORT=8080

# Private installation admission. Google only: the verified Google email of the owner on a NEW installation
# (with passkeys leave it empty; the first start prints a one-time setup code instead).
# Existing household memberships remain admitted. Other people use an invitation issued in the app.
BAYIT_BOOTSTRAP_EMAIL=
BAYIT_ALLOWED_EMAILS=
BAYIT_REGISTRATION_MODE=private
BAYIT_MAX_HOUSEHOLDS=1

# Passkeys ("מפתח גישה"): on by default, need BAYIT_ORIGIN above (https, or http://localhost on this computer only).
# The first start prints a one-time setup code (also in setup-code.txt in the data volume) while nobody has set up.
# Set off to offer Google only. BAYIT_SETUP_CODE sets your own code instead (also needed to keep the code path open
# when BAYIT_BOOTSTRAP_EMAIL is set). Recovery when the only parent is locked out: docker compose exec bayit node recovery-cli.mjs
BAYIT_PASSKEYS=on
# Behind Caddy, a tunnel or Tailscale (any https address): who may forward the visitor's address. Without it every
# visitor counts as the proxy and one stranger can block passkey sign-in. Only list proxies that overwrite or append
# X-Forwarded-For (Caddy 2 does). Caddy profile: the compose network subnet, e.g. 172.18.0.0/16 (docs/self-hosting-docker.md).
BAYIT_TRUSTED_PROXIES=
BAYIT_SETUP_CODE=

# Optional: explicitly approved custom AI origins, comma-separated, HTTPS only.
# Built-in providers and the listed known custom providers work without this setting.
AI_ALLOWED_ORIGINS=
# Deliberately grants outbound access to an operator-controlled private AI origin. Never use a wildcard.
AI_PRIVATE_ORIGINS=

# Optional versioned credential rotation: choose a NEW ID when changing APP_ENCRYPTION_KEY.
APP_ENCRYPTION_KEY_ID=main
# Keep old version IDs (and "legacy" for pre-v2 ciphertext) in the secret key ring until re-encryption.
APP_ENCRYPTION_KEYS_JSON=
# Instead of plaintext environment values, Docker secrets/files may supply these inputs.
AUTH_SECRET_FILE=
APP_ENCRYPTION_KEY_FILE=
REMINDER_CRON_SECRET_FILE=
APP_ENCRYPTION_KEYS_JSON_FILE=

# Financial PDF parsing: installation-wide daily limit; two jobs may run at once.
PDF_DAILY_LIMIT=20
